{
  "manifest_version": 3,
  "name": "Sovereign Web Toggle",
  "version": "1.1",
  "description": "Toggles connection to the local Sovereign Web daemon.",
  "icons": {
      "128": "icon.png"
  },
  "permissions": [
    "privacy",
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
